# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173
SITE_URL=http://localhost:5173

# Authentication
JWT_SECRET=replace-with-a-long-random-secret

# Admin bootstrap (only used if no admin exists)
ADMIN_EMAIL=admin@example.com

# Email — use either an API provider or SMTP
EMAIL_FROM=Noor Mist
EMAIL_FROM_ADDRESS=noreply@example.com
EMAIL_USER=
EMAIL_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false

# Optional provider settings (admin Email Settings can manage these)
EMAIL_PROVIDER=brevo
EMAIL_API_KEY=
EMAIL_API_DOMAIN=

# Optional
DEFAULT_CONTACT_EMAIL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
